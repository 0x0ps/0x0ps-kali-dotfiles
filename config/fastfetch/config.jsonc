{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "@USER_HOME@/.config/fastfetch/0x0ps.png",
    "width": 40,
    "height": 20,
    "padding": {
      "top": 2,
      "right": 3
    }
  },

  "display": {
    "separator": " "
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "keyWidth": 22,
      "outputColor": "#A6FF00"
    },

    {
      "type": "os",
      "key": "  OS",
      "keyColor": "#FF00AF"
    },
    {
      "type": "host",
      "key": "├󰌢 Host",
      "keyColor": "#FF00AF"
    },
    {
      "type": "kernel",
      "key": "├ Kernel",
      "keyColor": "#FF00AF"
    },
    {
      "type": "packages",
      "key": "├󰏖 Packages",
      "keyColor": "#FF00AF"
    },
    {
      "type": "shell",
      "key": "├ Shell",
      "keyColor": "#FF00AF"
    },
    {
      "type": "localIP",
      "key": "├󰩟 Local IP",
      "keyColor": "#FF00AF"
    },
    {
      "type": "uptime",
      "key": "└󰅐 Uptime",
      "keyColor": "#FF00AF"
    },

    {
      "type": "break"
    },

    {
      "type": "de",
      "key": " Desktop",
      "keyColor": "#00DCFF"
    },
    {
      "type": "wm",
      "key": "├󰧨 Window Manager",
      "keyColor": "#00DCFF"
    },
    {
      "type": "lm",
      "key": "├󰗼 Login Manager",
      "keyColor": "#00DCFF"
    },
    {
      "type": "wmtheme",
      "key": "├󰉼 WM Theme",
      "keyColor": "#00DCFF"
    },
    {
      "type": "theme",
      "key": "├󰉼 Color Theme",
      "keyColor": "#00DCFF"
    },
    {
      "type": "icons",
      "key": "├󰸉 System Icons",
      "keyColor": "#00DCFF"
    },
    {
      "type": "font",
      "key": "├ System Font",
      "keyColor": "#00DCFF"
    },
    {
      "type": "terminal",
      "key": "├ Terminal",
      "keyColor": "#00DCFF"
    },
    {
      "type": "display",
      "key": "└󰍹 Display",
      "keyColor": "#00DCFF"
    },

    {
      "type": "break"
    },

    {
      "type": "chassis",
      "key": "󰌢 PC",
      "keyColor": "#A6FF00"
    },
    {
      "type": "board",
      "key": "├ Motherboard",
      "keyColor": "#A6FF00"
    },
    {
      "type": "cpu",
      "key": "├󰻠 CPU",
      "keyColor": "#A6FF00",
      "temp": true,
      "freqNdigits": 1
    },
    {
      "type": "memory",
      "key": "├󰑭 RAM",
      "keyColor": "#A6FF00"
    },
    {
      "type": "swap",
      "key": "├󰓡 Swap",
      "keyColor": "#A6FF00"
    },
    {
      "type": "disk",
      "key": "├ Disk",
      "keyColor": "#A6FF00"
    },
    {
      "type": "gpu",
      "key": "├󰢮 GPU",
      "keyColor": "#A6FF00"
    },
    {
      "type": "opengl",
      "key": "├󰍛 OpenGL",
      "keyColor": "#A6FF00"
    },
    {
      "type": "vulkan",
      "key": "├󰍛 Vulkan",
      "keyColor": "#A6FF00"
    },
    {
      "type": "break"
    },
    {
      "type": "colors"
    }
  ]
}
