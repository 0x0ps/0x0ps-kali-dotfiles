{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "@USER_HOME@/.config/fastfetch/0x0ps.png",
    "width": 40,
    "height": 20,
    "padding": {
      "right": 3
    }
  },
  "display": {
    "separator": "  ❯ "
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator", "string": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" },

    { "type": "separator", "string": "▌ IDENTITY" },
    { "type": "os", "key": "OS", "keyColor": "#FF00AF", "outputColor": "#FFFFFF" },
    { "type": "host", "key": "HOST", "keyColor": "#FF00AF", "outputColor": "#FFFFFF" },
    { "type": "kernel", "key": "KERNEL", "keyColor": "#FF00AF", "outputColor": "#FFFFFF" },
    { "type": "uptime", "key": "UPTIME", "keyColor": "#FF00AF", "outputColor": "#FFFFFF" },
    { "type": "packages", "key": "PACKAGES", "keyColor": "#FF00AF", "outputColor": "#FFFFFF" },
    { "type": "shell", "key": "SHELL", "keyColor": "#FF00AF", "outputColor": "#FFFFFF" },

    { "type": "break" },
    { "type": "separator", "string": "▌ ENVIRONMENT" },
    { "type": "display", "key": "DISPLAY", "keyColor": "#00DCFF", "outputColor": "#FFFFFF" },
    { "type": "de", "key": "DESKTOP", "keyColor": "#00DCFF", "outputColor": "#FFFFFF" },
    { "type": "wm", "key": "WINDOW MANAGER", "keyColor": "#00DCFF", "outputColor": "#FFFFFF" },
    { "type": "terminal", "key": "TERMINAL", "keyColor": "#00DCFF", "outputColor": "#FFFFFF" },

    { "type": "break" },
    { "type": "separator", "string": "▌ HARDWARE" },
    { "type": "cpu", "key": "CPU", "keyColor": "#A6FF00", "outputColor": "#FFFFFF" },
    { "type": "gpu", "key": "GPU", "keyColor": "#A6FF00", "outputColor": "#FFFFFF" },
    { "type": "memory", "key": "MEMORY", "keyColor": "#A6FF00", "outputColor": "#FFFFFF" },
    { "type": "disk", "key": "DISK", "keyColor": "#A6FF00", "outputColor": "#FFFFFF" },

    { "type": "break" },
    { "type": "colors" }
  ]
}
