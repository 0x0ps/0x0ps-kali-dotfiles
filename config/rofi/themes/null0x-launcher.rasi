configuration {
    show-icons: true;
    drun-display-format: "{name}";
}

* {
    font: "RobotoMono Nerd Font 11";
    foreground: #FFFFFF;
    background-color: transparent;
}

window {
    width: 760px;
    padding: 18px;
    border: 2px;
    border-color: #FF00AF;
    background-color: transparent;
}

mainbox {
    spacing: 12px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 12px;
    spacing: 10px;
    background-color: transparent;
    children: [ prompt, entry ];
}

prompt {
    text-color: #A6FF00;
}

entry {
    text-color: #A6FF00;
    placeholder: "Search applications";
    placeholder-color: #00FFFF;
}

listview {
    columns: 4;
    lines: 3;
    spacing: 8px;
    fixed-height: false;
}

element {
    padding: 10px;
    background-color: transparent;
    text-color: #A6FF00;
}

element normal.normal {
    text-color: #A6FF00;
}

element selected {
    background-color: rgba ( 255, 0, 175, 65 % );
    text-color: #FFFFFF;
}

element selected.normal {
    background-color: rgba ( 255, 0, 175, 65 % );
    text-color: #FFFFFF;
}

element-text {
    text-color: inherit;
    background-color: transparent;
}

element-icon {
    size: 32px;
    background-color: transparent;
}
